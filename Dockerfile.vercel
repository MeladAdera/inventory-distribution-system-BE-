# Demo branch only: Vercel builds this (vercel.json sets framework: container).
# Same build as the production Dockerfile, plus build tools, on port 80.

# Build stage
FROM node:20-alpine AS builder

# bcrypt's prebuilt binary doesn't download on Vercel's builder, so it compiles
# from source. Only this stage needs the tools; the final image copies the result.
RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package*.json ./
RUN npm ci && npm cache clean --force

COPY . .
RUN npm run build

# Production stage
FROM node:20-alpine

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./
COPY . .

# Vercel routes to port 80 by default.
ENV PORT=80
EXPOSE 80

CMD ["npm", "run", "start:prod"]
